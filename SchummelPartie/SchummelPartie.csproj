<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>SchummelPartie</AssemblyName>
    <RootNamespace>SchummelPartie</RootNamespace>
    <GameDirectory Condition="'$(GameDirectory)' == ''">C:\SteamLibrary\steamapps\common\Pummel Party</GameDirectory>
    <GameManagedDirectory>$(GameDirectory)\PummelParty_Data\Managed</GameManagedDirectory>
    <MelonLoaderDirectory Condition="'$(MelonLoaderDirectory)' == ''">$(GameDirectory)\MelonLoader\net35</MelonLoaderDirectory>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDirectory)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDirectory)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDirectory)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UrGUI">
      <HintPath>$(GameDirectory)\UserLibs\UrGUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDirectory)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidgren.Network">
      <HintPath>$(GameManagedDirectory)\Lidgren.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDirectory)\UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedDirectory)\Assembly-CSharp.dll')" Text="Pummel Party was not found. Set GameDirectory to the game installation folder." />
    <Error Condition="!Exists('$(MelonLoaderDirectory)\MelonLoader.dll')" Text="MelonLoader was not found. Set MelonLoaderDirectory to its Mono runtime folder." />
    <Error Condition="!Exists('$(GameDirectory)\UserLibs\UrGUI.dll')" Text="UrGUI.dll was not found in the game's UserLibs folder." />
  </Target>
</Project>
